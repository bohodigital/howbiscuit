{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howbiscuit.com/schemas/public-promotion-package.v1.schema.json",
  "title": "How Biscuit public promotion package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "approvalDigest",
    "files",
    "removedFiles",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "public-promotion-package.v1"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "approvalDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 78643200
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "removedFiles": {
      "type": "array",
      "maxItems": 3000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/articles/[a-z0-9]+(?:-[a-z0-9]+)*/$"
      }
    }
  }
}
